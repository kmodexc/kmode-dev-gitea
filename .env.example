# Public URL users use to reach Gitea. It must match Apache's HTTPS URL.
GITEA_DOMAIN=git.kmode.dev
GITEA_ROOT_URL=https://git.kmode.dev/

# Bind the web listener only on localhost for Apache TLS offloading.
GITEA_HTTP_BIND_ADDRESS=127.0.0.1
GITEA_HTTP_BIND_PORT=10301

# SSH can use a separate address and port. Use 127.0.0.1 here too if SSH is
# also exposed through a TCP-capable proxy or local forwarding service.
GITEA_SSH_BIND_ADDRESS=0.0.0.0
GITEA_SSH_BIND_PORT=2222
GITEA_SSH_PORT=2222

# Keep password-based web/API authentication disabled. Set these to true only
# temporarily if you need to use a local bootstrap account during setup.
GITEA_ENABLE_PASSWORD_SIGNIN_FORM=false
GITEA_ENABLE_BASIC_AUTHENTICATION=false

# Generate a long random value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The current OIDC realm exposed by auth.kmode.dev.
KEYCLOAK_DISCOVERY_URL=https://auth.kmode.dev/realms/kmode/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=gitea
KEYCLOAK_CLIENT_SECRET=replace-with-the-keycloak-client-secret
KEYCLOAK_AUTO_CONFIGURE=true

# Keycloak client-role claim used by Gitea. Configure a Keycloak "User Client
# Role" mapper to emit the roles of KEYCLOAK_CLIENT_ID into this claim.
KEYCLOAK_GROUP_CLAIM_NAME=gitea_roles

# A user must have this client role in order to log in to Gitea.
KEYCLOAK_REQUIRED_ROLE=gitea-user

# These roles control Gitea's built-in flags. Leave either value empty to
# disable that mapping.
KEYCLOAK_ADMIN_ROLE=gitea-admin
KEYCLOAK_RESTRICTED_ROLE=gitea-restricted

# Map Keycloak client roles to Gitea organization teams. The organizations and
# teams must already exist in Gitea. Use {} when team mapping is not needed.
KEYCLOAK_GROUP_TEAM_MAP='{}'
KEYCLOAK_GROUP_TEAM_MAP_REMOVAL=true
